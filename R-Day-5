/******************************************************************************

            Write a program to count a even number in the array.
            arr = [3, 8, 12, 5, 7, 10, 14]

*******************************************************************************/

public class Main
{
	public static void main(String[] args) {
		int [] arr = {3,8,12,5,7,10, 14};
		
		int count = 0;
		
		for(int i = 0; i < arr.length; i++){
		    if(arr[i] % 2 == 0){
		        count++;
		    }
		}
		System.out.println(count);
	}
}
