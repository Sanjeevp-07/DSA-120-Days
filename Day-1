//Q4. Take two integers and print the larger number.

import java.util.Scanner;

public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        
        int x = sc.nextInt();
        int y = sc.nextInt();
        
        if(x < y){
            System.out.println(y + " is the greater number");
        }else{
            System.out.println(x + " is the greater number");
        }
    }
}



//Q5. Take three integers and print the largest.

import java.util.Scanner;

public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        
        int x = sc.nextInt();
        int y = sc.nextInt();
        int z = sc.nextInt();
        
        if(x < y && y < z){
            System.out.println(z + " is the greater number");
        }else if(y < x && z < x){
            System.out.println(x + " is the greater number");
        }
        else if(x < y && z < y){
            System.out.println(y + " is the greater number");
        }
    }
}








//Q7. Given an integer n, determine whether it is divisible by both 3 and 5.

import java.util.Scanner;

public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        
        int x = sc.nextInt();
        
        if(x % 3 == 0 && x % 5 == 0){
            System.out.println(x + " is divisible by 3 and 5 both");
        }else{
            System.out.println(x + " is divisible by 3 and 5 both");
        }
        
    }
}
