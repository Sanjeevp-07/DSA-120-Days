import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int n = sc.nextInt();

		if(n > 0 && n % 2 ==0) {
			System.out.println(n +" is a positive and Even integer");
		} else if(n > 0 && n % 2 != 0) {
			System.out.println(n + " is a positive and odd integer");
		}
		else if(n < 0) {
			System.out.println(n+ "is a negative integer");
		}
		else {
			System.out.println(n+ "is equal to Zero");
		}
	}
}





import java.util.Scanner;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);

		int n = sc.nextInt();
		int m = sc.nextInt();
        
        int sum = n + m;
        int Differ = n - m;
        int product = n * m;
        int quotient = n / m;
        int remainder = n % n;
        
        System.out.println(sum);
        System.out.println(Differ);
        System.out.println(product);
        System.out.println(quotient);
        System.out.println(remainder);
	}
}


