
//Find Maximum element of array 

import java.util.*;

public class Main
{
    public static void maxArray(int [] arr){
        int max = 0;
        for(int i = 0; i < arr.length; i++) {
			if(max < arr[i]){
			    max = arr[i];
			}
		}
		System.out.print(max);
    }
	public static void main(String[] args) {

		Scanner sc  = new Scanner(System.in);
		int n = sc.nextInt();

		int [] nums = new int[n];

		for(int i = 0; i < n; i++) {
			nums[i] = sc.nextInt();
		}
		
		maxArray(nums);
		

	}
}


