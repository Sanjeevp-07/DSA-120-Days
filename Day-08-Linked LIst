//19.remove Nth node from the end 


class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {
        ListNode dummy = new ListNode(0);
        dummy.next = head;

        ListNode slow = dummy;
        ListNode fast = dummy;

        for(int i = 0; i<=n; i++){
            fast = fast.next;
        }

        while(fast != null){
            slow = slow.next;
            fast = fast.next;

        }
        slow.next = slow.next.next; 

        return dummy.next;
    }
}

TC = O(n)
SC = O(1)




// 2. Add two Numbers (x,y,carry, digit, tail, dummy) 

class Solution {
    public ListNode addTwoNumbers(ListNode l1, ListNode l2) {
        ListNode dummy = new ListNode(0);
        ListNode tail = dummy;

        int carry = 0;

        while(l1 != null || l2 != null || carry != 0){

            int x = 0; 
            if(l1 != null){
                x = l1.val;
            }

            int y = 0;
            if(l2 != null){
                y = l2.val;
            }
            int sum = x + y + carry ;

            carry = sum /10;

            int Digit = sum % 10;


            tail.next = new ListNode(Digit);
            tail = tail.next;
            

            if (l1 != null){
                l1 = l1.next;
            }
            if (l2 != null){
                l2 = l2.next;
            }
        }
        return dummy.next;
    }
}

